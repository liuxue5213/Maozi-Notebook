# 复制为 .env 使用;不设置时默认走嵌入式 PGlite(零配置开发)
# 标准 PostgreSQL:
# DATABASE_URL=postgres://postgres:ledgerone@localhost:5432/ledgerone
DATABASE_URL=pglite://data/ledgerone
# JWT 密钥:生产必须 ≥32 位且非默认值(启动强校验,上线前全检 B1);下方仅为格式示例,请自行生成 64 位随机串:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-0000000000000000000000000000000000000000
PORT=60505
# 开发模式:短信验证码直接随接口返回,便于联调
DEV_MODE=true
