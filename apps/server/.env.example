# 复制为 .env 使用;先在项目根目录启动 docker compose up -d
# 生产环境请使用独立凭据与 TLS 连接
DATABASE_URL=mysql://ledgerone:ledgerone@127.0.0.1:3306/ledgerone
# JWT 密钥:生产必须 ≥32 位且非默认值(启动强校验,上线前全检 B1);下方仅为格式示例,请自行生成 64 位随机串:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-0000000000000000000000000000000000000000
PORT=60505
# 开发模式:短信验证码直接随接口返回,便于联调
DEV_MODE=true
# 跨域白名单(F-09):生产必须显式配置(逗号分隔),漏配时拒绝跨域不反射;开发态留空放行本地前端
# CORS_ORIGIN=http://localhost:60500,https://your-domain.com

# AI 分析(阿里云百炼 OpenAI 兼容模式,qwen-plus)
AI_API_KEY=
AI_BASE_URL=https://llm-jufv4y6r83r9f3n9.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
