{
  "expo": {
    "name": "帽子记账本",
    "slug": "ledgerone",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f7f9",
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ledgerone.app",
      "infoPlist": {
        "NSCameraUsageDescription": "拍摄票据作为记账附件",
        "NSMicrophoneUsageDescription": "语音记账的语音输入",
        "NSFaceIDUsageDescription": "用于应用锁快速解锁"
      }
    },
    "android": {
      "package": "com.ledgerone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4361ee"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4361ee"
    }
  }
}
